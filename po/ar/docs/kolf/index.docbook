></keycombo
> </shortcut
> <guimenu
>لعبة</guimenu
> <guimenuitem
>أنهِ</guimenuitem
> </menuchoice
></term>
<listitem
><para
><action
>الخروج</action
> من غولف.</para
></listitem>
</varlistentry>
</variablelist>

</sect1>

